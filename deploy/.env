# ------------------------------------
# --- BACKEND (.NET) SERVICE       ---
# ------------------------------------
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:7000

ConnectionStrings__SnippetsConnection=Host=db;Port=5432;Database=snippets;Username=postgres;Password=YourStrongPasswordHere
ConnectionStrings__UsersConnection=Host=db;Port=5432;Database=users;Username=postgres;Password=YourStrongPasswordHere

Authentication__Supabase__ProjectUrl=https://your-project-ref.supabase.co
Authentication__Supabase__JwtSecret=YourVeryLongAndSecureSupabaseJWTSecret
Authentication__Supabase__Audience=authenticated

# ------------------------------------
# --- FRONTEND (NEXT.JS) SERVICE   ---
# ------------------------------------
NODE_ENV=production
NEXT_PUBLIC_API_URL=/api

# Frontend Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=url
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key

# ------------------------------------
# --- DOCKER & COMMON SETTINGS     ---
# ------------------------------------
DOCKER_USERNAME=your-dockerhub-username

# Image tags - uncomment to pin specific versions, otherwise uses 'latest'
# When using Watchtower auto-updates, leave these commented for latest tag
#BACKEND_IMAGE_TAG=1.0.0
#FRONTEND_IMAGE_TAG=1.0.0

# ------------------------------------
# --- POSTGRESQL DATABASE          ---
# ------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=YourStrongPasswordHere

# ------------------------------------
# --- WATCHTOWER (AUTO-UPDATES)    ---
# ------------------------------------
# Check for new images every 5 minutes (300 seconds)
WATCHTOWER_POLL_INTERVAL=300

# Automatically remove old images after updating (recommended)
WATCHTOWER_CLEANUP=true

# Enable label-based filtering (only update containers with watchtower labels)
WATCHTOWER_LABEL_ENABLE=true

# Monitor containers with this scope (matches labels on backend/frontend)
WATCHTOWER_SCOPE=snippet

# Set to true to run once and exit (for manual/cron-based updates)
WATCHTOWER_RUN_ONCE=false

# Include restarting containers in monitoring
WATCHTOWER_INCLUDE_RESTARTING=true

# Include stopped containers in monitoring
WATCHTOWER_INCLUDE_STOPPED=false

# Enable debug logging (set to true for troubleshooting)
WATCHTOWER_DEBUG=false
WATCHTOWER_TRACE=false

# Optional: Notification URL for Slack/Discord/etc (leave empty to disable)
# Format examples:
#   Slack: slack://token-a/token-b/token-c
#   Discord: discord://token@channel
#   Email: smtp://username:password@host:port/?from=sender@example.com&to=recipient@example.com
WATCHTOWER_NOTIFICATION_URL=