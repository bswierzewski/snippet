<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <!-- Copy .env only if it exists (for local development) -->
    <None Update=".env" Condition="Exists('.env')">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <ItemGroup Label="BuildingBlocks References">
    <ProjectReference Include="..\..\BuildingBlocks\src\BuildingBlocks.Abstractions\BuildingBlocks.Abstractions.csproj" />
    <ProjectReference Include="..\..\BuildingBlocks\src\BuildingBlocks.Infrastructure\BuildingBlocks.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Local Module References">
    <ProjectReference Include="..\..\Modules\Snippets\Snippet.Modules.Snippets.Application\Snippet.Modules.Snippets.Application.csproj" />
    <ProjectReference Include="..\..\Modules\Snippets\Snippet.Modules.Snippets.Infrastructure\Snippet.Modules.Snippets.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup Label="Package References">
    <PackageReference Include="DotNetEnv" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <!-- PrivateAssets="all" ensures this dev-tool doesn't end up in the production container -->
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- Run BuildingBlocks.Tools after build to generate .env template (Debug only) -->
  <Target Name="RunBuildingBlocksTools" AfterTargets="Build" Condition="'$(Configuration)' == 'Debug'">
    <Exec Command="dotnet bb env generate" WorkingDirectory="$(MSBuildProjectDirectory)" />
  </Target>

</Project>